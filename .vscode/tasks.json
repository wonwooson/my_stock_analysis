{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Verify: all tests and JavaScript",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["scripts/verify.py"],
      "options": {"cwd": "${workspaceFolder}", "env": {"PYTHONUTF8": "1"}},
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "Run: practice",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["launch.py", "--practice"],
      "options": {"cwd": "${workspaceFolder}", "env": {"PYTHONUTF8": "1"}},
      "problemMatcher": []
    }
  ]
}
